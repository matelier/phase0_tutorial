control {
	condition = initial
}

accuracy {
	cutoff_wf = 20.0 rydberg
	cutoff_cd = 80.0 rydberg
	num_bands = 8
	ksampling {
		mesh { nx = 4, ny = 4, nz = 4 }
	}
}

structure {
	unit_cell_type = Bravais
	unit_cell {
		a = 5.47 angstrom
	}
	symmetry {
		method = automatic
		tspace { lattice_system = facecentered }
		sw_inversion = on
	}
	atom_list {
		atoms {
		#tag  element rx ry rz
			Si   0.125   0.125   0.125
			Si  -0.125  -0.125  -0.125
		}
	}
	element_list {
	#tag  element atomicnumber
		Si   14
	}
}

phonon {
	sw_phonon = on
	sw_calc_force = on
	sw_vibrational_modes = on
}

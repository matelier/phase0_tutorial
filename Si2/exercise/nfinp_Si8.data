control {
	condition = initial
}

accuracy {
	cutoff_wf = 20.0 rydberg
	cutoff_cd = 80.0 rydberg
	num_bands = 2
	ksampling {
		mesh { nx = 4, ny = 4, nz = 4 }
	}
}

structure {
	unit_cell_type = Bravais
	unit_cell {
		a = 5.47 angstrom
	}
	symmetry {
		method = automatic
	!	tspace { lattice_system = facecentered }
		sw_inversion = on
	}
	atom_list {
		atoms {
		#tag  element rx ry rz
			Si   0.125   0.125   0.125
			Si   0.125   0.625   0.625
			Si   0.625   0.125   0.625
			Si   0.625   0.625   0.125
			Si   0.875   0.875   0.875
			Si   0.875   0.375   0.375
			Si   0.375   0.875   0.375
			Si   0.375   0.375   0.875
		}
	}
	element_list {
	#tag  element atomicnumber
		Si   14
	}
}

postprocessing {
	charge {
		sw_charge_rspace = on
		filetype = cube
	}
}

control {
	condition = initial
}

accuracy {
	cutoff_wf = 20.0 rydberg
	cutoff_cd = 80.0 rydberg
	num_bands = 2
	ksampling {
		mesh { nx = 4, ny = 4, nz = 4 }
	}
}

structure {
	unit_cell_type = Bravais
	unit_cell {
	!	a = 5.47 angstrom
		a = 3.867874093090414958472618660713524 angstrom  ! 5.47 / sqrt(2)
		c = 5.47 angstrom
	}
	symmetry {
		method = automatic
		sw_inversion = on
	}
	atom_list {
		atoms {
		#tag  element rx ry rz
			Si   0.0   0.25   0.125
			Si   0.5   0.75   0.625
			Si   0.5   0.25   0.375
			Si   0.0   0.75   0.875
		}
	}
	element_list {
	#tag  element atomicnumber
		Si   14
	}
}

postprocessing {
	charge {
		sw_charge_rspace = on
		filetype = cube
	}
}

control {
	condition = initial
}

accuracy {
	PAW = on
	cutoff_wf = 25.0 rydberg
	cutoff_cd = 225.0 rydberg
	num_bands = 16
	ksampling {
		mesh { nx = 10, ny = 10, nz = 10 }
	}
	initial_charge_density = atomic_charge_density
}

structure {
	unit_cell {
	#units angstrom
		a = 2.845
	}
	symmetry {
		method = automatic
		tspace { lattice_system = bodycentered }
		sw_inversion = on
	}
	atom_list {
		atoms {
		#tag  element rx ry rz
			Fe   0.0   0.0   0.0
		}
	}
	magnetic_state = ferro
	element_list {
	#tag  element atomicnumber zeta
		Fe   26   0.3
	}
}

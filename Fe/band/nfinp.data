control {
	condition = fixed_charge
}

accuracy {
	PAW = on
	cutoff_wf = 25.0 rydberg
	cutoff_cd = 225.0 rydberg
	num_bands = 12
	ksampling { method = file }
!	ek_convergence {
!		num_extra_bands = 8
!	}
}

structure {
	unit_cell_type = Bravais
	unit_cell {
	#units angstrom
		a = 2.845
	}
	symmetry {
		method = automatic
		tspace { lattice_system = bodycentered }
		sw_inversion = on
	}
	atom_list {
		atoms {
		#tag  element rx ry rz
			Fe   0.0   0.0   0.0
		}
	}
	magnetic_state = ferro
	element_list {
	#tag  element atomicnumber zeta
		Fe   26   0.3
	}
}
